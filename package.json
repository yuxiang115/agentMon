{
  "name": "agentmon",
  "version": "0.1.0",
  "private": true,
  "description": "Reference-first terminal V-Pet that lives inside your coding agent (CodePet implementation home)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "demo": "tsx tools/demo.ts",
    "demo:live": "tsx tools/demo.ts --live",
    "preview": "tsx tools/preview.ts",
    "session": "tsx tools/session.ts",
    "packs": "tsx tools/packs.ts",
    "pack:from-tuipet": "tsx tools/pack-from-tuipet.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true }
  },
  "pi": {
    "extensions": ["packages/pi-extension/index.ts"]
